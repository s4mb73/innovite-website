# Copy these keys into your Vercel project's Environment Variables.
# Never commit a real .env file.

# ── Required: form submission persistence ──────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...service-role-key...

# ── Optional (each unlocks one piece of Item #2). Each is independent ─
# Slack incoming webhook — posts a rich notification on every new lead
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Resend for transactional email (founder notification + lead auto-response)
RESEND_API_KEY=re_xxx
FROM_EMAIL=Sammy from Innovite <hello@innoviteai.com>
NOTIFY_EMAIL=sammy@innoviteai.com

# Anthropic for the AI-personalised auto-response copy
# (without this the lead still gets a clean templated email)
ANTHROPIC_API_KEY=sk-ant-xxx

# Calendly link surfaced in the auto-response
CALENDLY_URL=https://calendly.com/innovite/strategy-call
