# Copy this file's keys to your Vercel project's Environment Variables.
# Never commit a real .env file.

# Supabase — used by api/submit.js to persist form leads
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...service-role-key...

# --- Future env vars (Item #2 onwards) ---

# Slack incoming webhook for new-lead notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Resend for transactional email (founder notification + lead auto-response)
# RESEND_API_KEY=re_xxx
# NOTIFY_EMAIL=sammy@innoviteai.com
# FROM_EMAIL="Innovite <hello@innoviteai.com>"

# Anthropic for the AI-personalised auto-response
# ANTHROPIC_API_KEY=sk-ant-xxx

# Calendly link surfaced in the auto-response email
# CALENDLY_URL=https://calendly.com/innovite/strategy-call
