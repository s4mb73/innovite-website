# Supabase Postgres — Transaction pooler, port 6543
# Find in: Supabase dashboard → Project Settings → Database
#          → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Flask session secret (only used once auth is added)
FLASK_SECRET_KEY=change-me-to-a-long-random-string
